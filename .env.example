# Dedicated Hindsight bank for this organization/demo. Never share a bank across tenants.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incidentmind-demo
# true only for a trusted local Hindsight server without authentication
HINDSIGHT_ALLOW_UNAUTHENTICATED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Set a model supporting chat completions and JSON-object output.
LLM_MODEL=
REQUEST_TIMEOUT_SECONDS=120
